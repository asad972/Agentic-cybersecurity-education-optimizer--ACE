# Copy to .env and fill in. Never commit .env.

# Kafka and Cassandra (defaults match docker-compose.yml)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CASSANDRA_HOSTS=localhost
CASSANDRA_KEYSPACE=ace

# LLM module (S2, education agent, platform analysis agent)
LLM_PROVIDER=local              # 'local' (open-source model via Ollama) or 'hosted'
LLM_LOCAL_URL=http://localhost:11434
LLM_API_KEY=                    # only needed for LLM_PROVIDER=hosted
LLM_DAILY_BUDGET_EUR=2          # LLM module stops calling once today's spend reaches this

# Replay module (job ads and profile agents)
REPLAY_DATASET_DIR=shared/testdata   # fake data until the real dataset is chosen
REPLAY_SECONDS_PER_DAY=5             # 1 day of data plays in 5 seconds

# Threat-intelligence feeds (threat agent)
OTX_API_KEY=
ABUSEIPDB_API_KEY=

# Job ads API (job ads agent), if used
JOBS_API_KEY=
