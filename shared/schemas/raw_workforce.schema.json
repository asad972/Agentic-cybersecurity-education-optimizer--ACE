{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace/raw_workforce",
  "title": "raw.workforce message",
  "description": "Produced by the workforce agent from ISC2 annual workforce reports.",
  "type": "object",
  "required": [
    "country",
    "year",
    "source"
  ],
  "properties": {
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2; also the Kafka message key"
    },
    "year": {
      "type": "integer"
    },
    "workforce_size": {
      "type": "integer",
      "minimum": 0
    },
    "workforce_gap": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "examples": [
        "isc2_2024"
      ]
    }
  },
  "additionalProperties": false
}
