{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace/raw_workforce",
  "title": "raw.workforce message",
  "description": "Produced by the workforce agent from ISC2 reports at their published geographic scope.",
  "type": "object",
  "required": [
    "geography_level",
    "geography",
    "year",
    "source"
  ],
  "properties": {
    "geography_level": {
      "type": "string",
      "enum": ["country", "region", "global"]
    },
    "geography": {
      "type": "string",
      "minLength": 1,
      "description": "ISO alpha-2 code for country rows; published name for regions; GLOBAL for global rows"
    },
    "year": {
      "type": "integer",
      "minimum": 1900
    },
    "workforce_size": {
      "type": "integer",
      "minimum": 0
    },
    "workforce_gap": {
      "type": "integer",
      "minimum": 0
    },
    "workforce_growth_percent": {
      "type": "number"
    },
    "workforce_gap_growth_percent": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "https://www.isc2.org/Insights/2024/10/ISC2-2024-Cybersecurity-Workforce-Study"
      ]
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "description": "Figure, table, or page reference in the source"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"geography_level": {"const": "country"}},
        "required": ["geography_level"]
      },
      "then": {
        "properties": {
          "geography": {
            "pattern": "^[A-Z]{2}$",
            "not": {"const": "EU"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"geography_level": {"const": "global"}},
        "required": ["geography_level"]
      },
      "then": {
        "properties": {"geography": {"const": "GLOBAL"}}
      }
    }
  ],
  "additionalProperties": false
}
