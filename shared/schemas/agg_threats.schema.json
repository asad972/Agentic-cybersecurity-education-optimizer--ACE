{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace/agg_threats",
  "title": "agg.threats_hourly / agg.threats_daily message",
  "description": "One closed window for one country. hour is set only on agg.threats_hourly (0-23, UTC).",
  "type": "object",
  "required": [
    "country",
    "day",
    "counts"
  ],
  "properties": {
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2; also the Kafka message key"
    },
    "day": {
      "type": "string",
      "format": "date"
    },
    "hour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 23
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "threat_type -> count"
    }
  },
  "additionalProperties": false
}
