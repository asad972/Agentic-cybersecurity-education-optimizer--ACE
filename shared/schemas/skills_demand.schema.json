{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ace/skills_demand",
  "title": "skills.demand message",
  "description": "Produced by S2 from one de-duplicated job ad. Every skill, certification and role is a Skill Taxonomy entry.",
  "type": "object",
  "required": [
    "event_id",
    "source",
    "country",
    "posted_date",
    "skills"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "string",
      "examples": [
        "adzuna"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2; also the Kafka message key"
    },
    "posted_date": {
      "type": "string",
      "format": "date"
    },
    "job_title": {
      "type": "string"
    },
    "ecsf_role": {
      "type": "string",
      "description": "ECSF role profile name"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mentions that matched no taxonomy entry; counted for pipeline health and by S9 (emerging skills); never shown on maps"
    }
  },
  "additionalProperties": false
}
