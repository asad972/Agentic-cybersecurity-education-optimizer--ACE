{
  "uid": "ace-pipeline-health",
  "title": "ACE pipeline health",
  "description": "Records per source, duplicates, extraction, Unmapped Skills, late and invalid records, consumer lag, LLM spend and orchestrator tasks.",
  "tags": [
    "ace",
    "pipeline-health"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Service health",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Services up",
      "description": "Every service Prometheus collects metrics from. DOWN means Prometheus could not reach it at the last scrape. Flink shows DOWN until the Flink cluster runs.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "ace-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 14,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ace-prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}} · {{instance}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
