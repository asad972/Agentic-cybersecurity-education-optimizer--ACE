        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ace-prometheus"
          },
          "expr": "sum by (topic, source) (increase(ace_records_total{topic=~\"raw.jobs|raw.profiles|raw.programmes|raw.workforce|threats.events\"}[$__range]))",
          "legendFormat": "{{topic}} · {{source}}",
          "refId": "A",
          "instant": true,
          "range": false
