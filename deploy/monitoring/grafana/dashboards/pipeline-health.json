      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ace-prometheus"
          },
          "expr": "clamp_min(1 - sum(increase(ace_records_total{topic=\"jobs.clean\"}[$__range])) / (sum(increase(ace_records_total{topic=\"raw.jobs\"}[$__range])) > 0), 0)",
