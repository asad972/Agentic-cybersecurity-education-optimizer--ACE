    {
      "type": "stat",
      "title": "Duplicates removed by S1",
      "description": "Job ads that came in on raw.jobs but were not passed on to jobs.clean by S1 (near-duplicate filter) in the selected time range. Includes job ads S1 has not processed yet.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "ace-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "ace-prometheus"
          },
          "expr": "clamp_min((sum(increase(ace_records_total{topic=\"raw.jobs\"}[$__range])) or vector(0)) - (sum(increase(ace_records_total{topic=\"jobs.clean\"}[$__range])) or vector(0)), 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
